fn matmul_sum(n):
    set total = 0
    set i = 0
    while i < n:
        set j = 0
        while j < n:
            set acc = 0
            set k = 0
            while k < n:
                set a = (i + k) % 17
                set b = (k * j + 1) % 13
                set acc = acc + a * b
                set k = k + 1
            set total = total + acc
            set j = j + 1
        set i = i + 1
    return total

set result = matmul_sum(4)
print(result)
