# ═══════════════════════════════════════════════════════════
#  TEST 06 — Match / case pattern matching
#  Expected:
#    one
#    two
#    three
#    other
#    small
#    big
# ═══════════════════════════════════════════════════════════

fn describe(code):
    match code:
        case 1:
            print("one")
        case 2:
            print("two")
        case 3:
            print("three")
        case _:
            print("other")

describe(1)
describe(2)
describe(3)
describe(99)

set n = 5
match n:
    case 5:
        print("small")
    case 100:
        print("big")
    case _:
        print("other")

set m = 100
match m:
    case 5:
        print("small")
    case 100:
        print("big")
    case _:
        print("other")
