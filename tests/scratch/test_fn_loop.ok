# Minimal regression: fn called inside while loop, result stored
fn add_up(n):
    set s = 0
    set i = 0
    while i < n:
        set s = s + i
        set i = i + 1
    return s

set result = 0
set reps = 0
while reps < 3:
    set result = add_up(5)
    set reps = reps + 1

print(result)
# Expected: 10  (0+1+2+3+4)
