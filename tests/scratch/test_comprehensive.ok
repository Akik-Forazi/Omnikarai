# test_comprehensive.ok
# Tests every feature currently supported by omnicc codegen

# ── 1. Basic variable assignment ──────────────────────────────
set a = 42
set b = 8
print(a)
print(b)

# ── 2. Arithmetic ─────────────────────────────────────────────
set add_result = a + b
set sub_result = a - b
set mul_result = a * b
set div_result = a / b
print(add_result)
print(sub_result)
print(mul_result)
print(div_result)

# ── 3. String printing ────────────────────────────────────────
print("omnikarai")
print("hello from fraziym")

# ── 4. Boolean literals ───────────────────────────────────────
set t = true
set f = false
print(t)
print(f)

# ── 5. Comparison operators ───────────────────────────────────
set eq  = 10 == 10
set neq = 10 != 9
set lt  = 5 < 10
set gt  = 10 > 5
set lte = 5 <= 5
set gte = 6 >= 5
print(eq)
print(neq)
print(lt)
print(gt)
print(lte)
print(gte)

# ── 6. if / else ──────────────────────────────────────────────
set x = 100
if x > 50:
    print("x is big")
else:
    print("x is small")

# ── 7. if / elif / else ───────────────────────────────────────
set score = 75
if score >= 90:
    print("grade A")
elif score >= 75:
    print("grade B")
elif score >= 60:
    print("grade C")
else:
    print("grade F")

# ── 8. while loop ─────────────────────────────────────────────
set counter = 0
while counter < 5:
    print(counter)
    set counter = counter + 1

# ── 9. Nested arithmetic in condition ─────────────────────────
set p = 3
set q = 7
set sum = p + q
if sum == 10:
    print("sum is ten")

# ── 10. Negative numbers ──────────────────────────────────────
set neg = -99
print(neg)

# ── 11. Chained operations ────────────────────────────────────
set chain = 2 + 3 * 4
print(chain)

# ── 12. Variable re-assignment ────────────────────────────────
set val = 1
set val = val + 1
set val = val + 1
print(val)

return 0
