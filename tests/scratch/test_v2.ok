# test_v2.ok — tests ALL features of omnicc v2.0
# Expected output is sequential, one value per line

# ── 1. Basic variables ────────────────────────────────────────
set a = 10
set b = 3
print(a)
print(b)

# ── 2. Arithmetic + modulo ────────────────────────────────────
print(a + b)
print(a - b)
print(a * b)
print(a / b)
print(a % b)

# ── 3. Comparisons ────────────────────────────────────────────
print(a == 10)
print(a != b)
print(b < a)
print(a > b)
print(a >= 10)
print(b <= 3)

# ── 4. Logical operators ──────────────────────────────────────
set t = true
set f = false
print(t and t)
print(t and f)
print(f or t)
print(f or f)
print(not t)
print(not f)

# ── 5. if / elif / else ───────────────────────────────────────
set score = 85
if score >= 90:
    print("A")
elif score >= 80:
    print("B")
elif score >= 70:
    print("C")
else:
    print("F")

# ── 6. while + break ─────────────────────────────────────────
set i = 0
while i < 10:
    if i == 5:
        break
    print(i)
    set i = i + 1

# ── 7. while + continue ───────────────────────────────────────
set j = 0
while j < 6:
    set j = j + 1
    if j == 3:
        continue
    print(j)

# ── 8. for loop (range) ───────────────────────────────────────
for k in range(5):
    print(k)

# ── 9. match / case ───────────────────────────────────────────
set code = 2
match code:
    case 1:
        print("one")
    case 2:
        print("two")
    case 3:
        print("three")
    case _:
        print("other")

# ── 10. User-defined functions ────────────────────────────────
fn add(x, y):
    return x + y

fn multiply(x, y):
    return x * y

fn factorial(n):
    if n <= 1:
        return 1
    return n * factorial(n - 1)

set sum = add(7, 8)
print(sum)

set product = multiply(4, 5)
print(product)

set fact5 = factorial(5)
print(fact5)

# ── 11. Nested function calls ─────────────────────────────────
fn square(n):
    return n * n

fn sum_of_squares(a, b):
    return square(a) + square(b)

print(sum_of_squares(3, 4))

# ── 12. str() and int() conversions ──────────────────────────
set n = 42
set s = str(n)
set back = int(s)
print(back)

# ── 13. Negative numbers ─────────────────────────────────────
set neg = -7
print(neg)
print(neg * -1)

# ── 14. Complex conditions ────────────────────────────────────
set x = 15
if x > 10 and x < 20:
    print("in range")

if x < 5 or x > 10:
    print("out of 5-10")

# ── Done ─────────────────────────────────────────────────────
return 0
