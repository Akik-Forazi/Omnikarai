# test_v3.ok — Omnikarai v5.0 comprehensive test
# Tests: all v2 features + string concat + range(start,stop) + list writeback + AI workloads

# ── 1. Core arithmetic ────────────────────────────────────────
set a = 10
set b = 3
print(a + b)
print(a - b)
print(a * b)
print(a / b)
print(a % b)

# ── 2. String concatenation ───────────────────────────────────
set greeting = "Hello" + ", " + "world"
print(greeting)

set n = 42
set msg = "The answer is: " + str(n)
print(msg)

# ── 3. range(start, stop) ────────────────────────────────────
set total = 0
for i in range(3, 8):
    set total = total + i
print(total)

# ── 4. range(start, stop, step) ──────────────────────────────
set evens = 0
for i in range(0, 10, 2):
    set evens = evens + i
print(evens)

# ── 5. Variable reassignment keeps correct type ───────────────
set x = 100
set x = x + 1
print(x)
set s = "initial"
set s = "updated"
print(s)

# ── 6. List + push writeback (no dangling pointer) ────────────
set lst = list.new()
list.push(lst, 10)
list.push(lst, 20)
list.push(lst, 30)
print(list.len(lst))
print(list.get(lst, 0))
print(list.get(lst, 2))

# ── 7. Functions + recursion ──────────────────────────────────
fn fib(n):
    if n <= 1:
        return n
    return fib(n - 1) + fib(n - 2)

print(fib(10))

# ── 8. AI: dot product ────────────────────────────────────────
fn dotprod(n):
    set s = 0
    for i in range(n):
        set s = s + i * (n - i)
    return s

print(dotprod(100))

# ── 9. AI: ReLU neuron (inline + nested loops) ────────────────
fn relu(x):
    if x > 0:
        return x
    return 0

fn neuron(inputs):
    set acc = 0
    for i in range(inputs):
        set w = (i + 1) % 7
        set raw = (i - inputs / 2) * w
        set acc = acc + relu(raw)
    return acc

print(neuron(64))

# ── Done ──────────────────────────────────────────────────────
print("ALL TESTS PASSED")
return 0
