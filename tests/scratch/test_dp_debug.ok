# Debug: step through dotprod manually
fn dotprod_debug(n):
    set s = 0
    set i = 0
    print(n)
    print(s)
    print(i)
    while i < n:
        set tmp = i * (n - i)
        set s = s + tmp
        set i = i + 1
    print(s)
    return s

set r = dotprod_debug(5)
print(r)
# n=5: sum of i*(5-i) for i=0..4 = 0+4+6+6+4 = 20
# prints: 5, 0, 0, 20, 20
