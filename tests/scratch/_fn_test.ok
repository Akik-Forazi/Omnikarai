# Use the sys and io and os libs to write the output into a txt file.
use io 
use os

set path = "C:\Users\akikf\programing\omnikarai\omniwin\out.txt"


fn add(a, b):
    return a + b

fn fib(n):
    if n <= 1:
        return n
    return fib(n - 1) + fib(n - 2)

print(add(3, 4))
print(fib(10))
print("done")
return 0
io.write(path, )