# Minimal regression: nested while inside fn, multiple vars
fn dotprod_small(n):
    set s = 0
    set i = 0
    while i < n:
        set s = s + i * (n - i)
        set i = i + 1
    return s

set result = dotprod_small(5)
print(result)
# n=5: i=0: 0*(5)=0, i=1: 1*4=4, i=2: 2*3=6, i=3: 3*2=6, i=4: 4*1=4 → total=20
