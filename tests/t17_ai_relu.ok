# TEST 17 — ai.relu: in-place ReLU via AVX2 VMAXPS
# We fill 8 floats: [-2,-1,0,1,2,3,4,5] as int32 bit-patterns
# After relu: [0,0,0,1,2,3,4,5]
# We check element [1] (was -1.0 = 0xBF800000 = -1082130432) becomes 0
# And element [4] (was 2.0 = 0x40000000 = 1073741824) stays 2.0

use ai

set arr = ai.alloc(8)
# fill with float bit-patterns: -2.0=0xC0000000, -1.0=0xBF800000, 0=0, 1.0=0x3F800000
# 2.0=0x40000000, 3.0=0x40400000, 4.0=0x40800000, 5.0=0x40A00000
ai.set(arr, 0, -1073741824)
ai.set(arr, 1, -1082130432)
ai.set(arr, 2, 0)
ai.set(arr, 3, 1065353216)
ai.set(arr, 4, 1073741824)
ai.set(arr, 5, 1077936128)
ai.set(arr, 6, 1082130432)
ai.set(arr, 7, 1084227584)

ai.relu(arr, 8)

set after_neg  = ai.get(arr, 0)
set after_neg2 = ai.get(arr, 1)
set after_zero = ai.get(arr, 2)
set after_pos  = ai.get(arr, 4)

print(after_neg)
print(after_neg2)
print(after_zero)
print(after_pos)

ai.free(arr)
