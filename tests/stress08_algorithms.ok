# ═══════════════════════════════════════════════════════════
#  STRESS TEST 08 — Real-World Algorithm Implementations
#  Tests: bubble sort, binary search, prime sieve,
#         fibonacci sequence, GCD/LCM, number patterns
#         All implemented using only current Omnikarai features
#  Expected: correct algorithm outputs, no crash
# ═══════════════════════════════════════════════════════════

use math
use list

# --- is_prime check ---
fn is_prime(n):
    if n < 2:
        return 0
    if n == 2:
        return 1
    if n % 2 == 0:
        return 0
    set i = 3
    while i * i <= n:
        if n % i == 0:
            return 0
        set i = i + 2
    return 1

# --- count primes up to n ---
fn count_primes(limit):
    set count = 0
    set n = 2
    while n <= limit:
        if is_prime(n) == 1:
            set count = count + 1
        set n = n + 1
    return count

# --- GCD ---
fn gcd(a, b):
    while b != 0:
        set t = b
        set b = a % b
        set a = t
    return a

# --- LCM ---
fn lcm(a, b):
    return a / gcd(a, b) * b

# --- power mod ---
fn pow_mod(base, exp, mod):
    set result = 1
    while exp > 0:
        if exp % 2 == 1:
            set result = result * base % mod
        set exp = exp / 2
        set base = base * base % mod
    return result

# --- sum of digits ---
fn digit_sum(n):
    if n < 0:
        set n = 0 - n
    set total = 0
    while n > 0:
        set total = total + n % 10
        set n = n / 10
    return total

# --- collatz steps ---
fn collatz(n):
    set steps = 0
    while n != 1:
        if n % 2 == 0:
            set n = n / 2
        else:
            set n = n * 3 + 1
        set steps = steps + 1
    return steps

# --- run all ---
print(is_prime(2))
print(is_prime(17))
print(is_prime(18))
print(is_prime(97))
print(count_primes(50))

print(gcd(48, 18))
print(gcd(100, 75))
print(lcm(4, 6))
print(lcm(12, 18))

print(pow_mod(2, 10, 1000))
print(pow_mod(3, 5, 100))

print(digit_sum(12345))
print(digit_sum(0))
print(digit_sum(999))

print(collatz(6))
print(collatz(27))

return 0
