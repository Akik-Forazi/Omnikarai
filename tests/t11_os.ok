# ═══════════════════════════════════════════════════════════
#  TEST 11 — OS module
#  Expected:
#    windows
#    (a path like C:\Users\...)
#    (a PID number > 0)
#    1    (PATH env exists)
# ═══════════════════════════════════════════════════════════

use os

set platform = os.platform()
print(platform)

set cwd = os.cwd()
print(cwd)

set pid = os.getpid()
print(pid)

set path_env = os.getenv("PATH")
set has_path = len(path_env)
if has_path > 0:
    print(1)
else:
    print(0)
