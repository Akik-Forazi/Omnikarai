# bench_dotprod.ok — AI: Dot Product  (10000 reps)
fn dotprod(n):
    set s = 0
    set i = 0

    while i < n:
        set s = s + i * (n - i)
        set i = i + 1

    return s

set reps = 0
set result = 0

while reps < 10000:
    set result = dotprod(1024)
    set reps = reps + 1

print(result)
