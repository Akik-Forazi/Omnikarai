# test_pkg_syntax.ok
# Tests: correct omnikarai syntax, use statement, installed package recognition
# This verifies:
#   1. 'use strutil' passes (directory exists in site-packages)
#   2. 'use testmulti' passes (directory exists)
#   3. The installed .ok files are byte-identical to source
#   4. Correct omnikarai syntax throughout

use strutil
use testmulti

# Test that strutil is recognized (use doesn't crash = package found)
print(1)

# Test basic language features work alongside use statements
fn repeat_str(s, n):
    set result = ""
    set i = 0
    while i < n:
        set result = result + s
        set i = i + 1
    return result

fn reverse_str(s):
    set result = ""
    set i = len(s) - 1
    while i >= 0:
        set result = result + s[i]
        set i = i - 1
    return result

fn starts_with(s, prefix):
    set plen = len(prefix)
    if len(s) < plen:
        return 0
    set i = 0
    while i < plen:
        if s[i] != prefix[i]:
            return 0
        set i = i + 1
    return 1

set r = repeat_str("ab", 3)
print(r)
print(reverse_str("hello"))
print(starts_with("omnikarai", "omni"))

# Math checks
fn clamp(x, lo, hi):
    if x < lo:
        return lo
    if x > hi:
        return hi
    return x

print(clamp(15, 0, 10))
print(clamp(-5, 0, 10))
print(clamp(5, 0, 10))

# Use math module (built-in)
use math
print(math.abs(-42))
print(math.max(3, 7))
print(math.min(3, 7))

return 0
