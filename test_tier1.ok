# test_tier1.ok — exercises all 6 Tier 1 fixes

# Fix 4: for item in list
set nums = [10, 20, 30, 40, 50]
set total = 0
for n in nums:
    total += n
print(total)

# Fix 2: augmented assignment operators
set x = 100
x += 5
x -= 3
x *= 2
x /= 6
print(x)

# Fix 3: index write
set arr = [1, 2, 3]
arr[1] = 99
print(arr[1])

# Fix 5: extended math functions
use math
set e1 = math.exp(0)
print(e1)
set c = math.cbrt(27)
print(c)
