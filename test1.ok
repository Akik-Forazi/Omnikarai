class Person:
    fn init(self, name, age):
        self.name = name
        self.age = age

    fn greet(self):
        print("Hello, " + self.name + ". And nice to know that you are " + self.age + " Years old!")

set input_name = input("Enter your name\n=> ")
set input_age = input("Enter your age\n=> ")

set p = Person(input_name, input_age)

p.greet()
