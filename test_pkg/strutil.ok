# repeat(s, n) — repeat string s, n times
fn repeat(s, n):
    set result = ""
    set i = 0
    while i < n:
        set result = result + s
        set i = i + 1
    return result

# pad_left(s, n, ch) — pad s to length n from the left with character ch
fn pad_left(s, n, ch):
    set result = s
    while len(result) < n:
        set result = ch + result
    return result

# pad_right(s, n, ch) — pad s to length n from the right with character ch
fn pad_right(s, n, ch):
    set result = s
    while len(result) < n:
        set result = result + ch
    return result

# count(s, sub) — count non-overlapping occurrences of sub in s
fn count(s, sub):
    set n = 0
    set i = 0
    set slen = len(s)
    set sublen = len(sub)
    while i <= slen - sublen:
        set found = 1
        set j = 0
        while j < sublen:
            if s[i + j] != sub[j]:
                set found = 0
            set j = j + 1
        if found == 1:
            set n = n + 1
            set i = i + sublen
        else:
            set i = i + 1
    return n

# reverse(s) — reverse a string
fn reverse(s):
    set result = ""
    set i = len(s) - 1
    while i >= 0:
        set result = result + s[i]
        set i = i - 1
    return result

# starts_with(s, prefix) — returns 1 if s starts with prefix, else 0
fn starts_with(s, prefix):
    set plen = len(prefix)
    if len(s) < plen:
        return 0
    set i = 0
    while i < plen:
        if s[i] != prefix[i]:
            return 0
        set i = i + 1
    return 1

# ends_with(s, suffix) — returns 1 if s ends with suffix, else 0
fn ends_with(s, suffix):
    set suflen = len(suffix)
    set slen = len(s)
    if slen < suflen:
        return 0
    set offset = slen - suflen
    set i = 0
    while i < suflen:
        if s[offset + i] != suffix[i]:
            return 0
        set i = i + 1
    return 1

# trim(s) — remove leading and trailing spaces
fn trim(s):
    set start = 0
    set end = len(s) - 1
    while start <= end and s[start] == " ":
        set start = start + 1
    while end >= start and s[end] == " ":
        set end = end - 1
    return s[start:end + 1]
